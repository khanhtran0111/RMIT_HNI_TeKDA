# Whitelist: only the product and the shared dev spec go to GitHub. Everything else stays local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/C1/
/C1/*
!/C1/README.md
!/C2/
/C2/*
!/C2/README.md
!/C2/*.mp4
!/C2/app/
!/C2/docs/
/C2/docs/*
!/C2/docs/SPEC.md
!/C2/docs/split.md
!/C2/demo/
/C2/demo/*
!/C2/demo/fixtures/
/C2/demo/fixtures/*
!/C2/demo/fixtures/heirloom.json

# Inside app/: secrets, local TideCloak state, build output
C2/app/.env
C2/app/.env.*
!C2/app/.env.example
C2/app/data/*
!C2/app/data/.gitkeep
C2/app/node_modules/
C2/app/.next/
C2/app/next-env.d.ts
*.tsbuildinfo
*.log
*.mv.db
*.trace.db
.DS_Store
Thumbs.db

# Public walkthrough build output and Vercel link (rebuilt by app/walkthrough/build.mjs)
C2/app/walkthrough/dist/
.vercel/
